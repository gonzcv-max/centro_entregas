# Copia este archivo como .streamlit/secrets.toml en local,
# o pega su contenido en "Secrets" dentro de share.streamlit.io.
# secrets.toml NUNCA debe subirse a GitHub (ya está en .gitignore).

# --- Opcional: persistencia automática a GitHub ---
# Si defines estas 3 llaves, cada vez que alguien de "Guardar cambios"
# la app hace commit del Excel actualizado directo al repo, así los
# cambios sobreviven aunque la app de Streamlit Cloud se reinicie.
# Sin esto, la app sigue funcionando, pero los cambios solo viven
# mientras el contenedor de Streamlit Cloud no se reinicie (ver README).

# GITHUB_TOKEN = "ghp_xxxxxxxxxxxxxxxxxxxx"   # Personal Access Token (repo scope)
# GITHUB_REPO  = "tu-usuario/tu-repo"
# GITHUB_BRANCH = "main"
